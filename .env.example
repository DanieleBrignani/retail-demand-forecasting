# Copy to .env. No secrets are committed; the values below are local-development defaults only.
POSTGRES_USER=retailfc
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=retailfc
GRAFANA_RO_PASSWORD=change-me-too
GRAFANA_ADMIN_PASSWORD=change-me-three

# Host ports (offset from common defaults so they do not clash with other local stacks)
POSTGRES_PORT=5452
MLFLOW_PORT=5050
API_PORT=8010
PREFECT_PORT=4210
EXPORTER_PORT=9118
PROMETHEUS_PORT=9095
GRAFANA_PORT=3005

# Where raw files / artifacts live on the host (mounted into containers)
RETAILFC_DATA_HOST=./data

# API authentication (required, no default). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Two comma-separated keys allow zero-downtime rotation. Minimum 16 characters.
RETAILFC_API_KEYS=
