{
 "uid": "retailfc-forecast-quality",
 "title": "RetailFC - Forecast quality, drift and data quality",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "tags": [
  "retailfc"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "WAPE on matured forecasts (by model version)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "retailfc_forecast_wape",
     "legendFormat": "{{granularity}} v{{model_version}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Bias (forecast - actual) / demand",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "retailfc_forecast_bias_pct",
     "legendFormat": "{{granularity}} v{{model_version}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Empirical interval coverage",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "retailfc_interval_coverage",
     "legendFormat": "{{granularity}} v{{model_version}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "DRIFT: PSI vs training reference (not an accuracy signal)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "retailfc_drift_psi",
     "legendFormat": "{{signal}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "DATA QUALITY indicators",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 7,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "retailfc_data_quality_failures",
     "legendFormat": "{{check}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "table",
   "title": "WAPE by horizon (matured forecasts, all batches)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "pg"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "rawSql": "SELECT horizon, sum(sum_abs_error)/NULLIF(sum(sum_actual),0) AS wape, sum(sum_error)/NULLIF(sum(sum_actual),0) AS bias_pct, sum(n) AS n FROM app.monitoring_aggregates GROUP BY 1 ORDER BY 1",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ]
  },
  {
   "id": 7,
   "type": "table",
   "title": "Performance by forecast batch (vintage)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "pg"
   },
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "rawSql": "SELECT forecast_batch_id, model_version, sum(n) AS n, sum(sum_abs_error)/NULLIF(sum(sum_actual),0) AS wape FROM app.monitoring_aggregates GROUP BY 1,2 ORDER BY 1 DESC",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ]
  },
  {
   "id": 8,
   "type": "table",
   "title": "Retraining decision audit trail",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "pg"
   },
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "rawSql": "SELECT decision_id, decided_at, decision, reasons->'triggers' AS triggers, challenger_version FROM app.retraining_decisions ORDER BY decision_id DESC LIMIT 20",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ]
  }
 ]
}